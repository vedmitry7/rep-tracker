POSTGRES_DB=rep_tracker
POSTGRES_USER=rep_tracker
POSTGRES_PASSWORD=change_me

# Keep localhost when FastAPI runs directly on the host machine, for example from PyCharm.
# Docker Compose overrides this with the internal service name "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local-only host port for tools running outside Docker, for example PyCharm.
POSTGRES_HOST_PORT=5432

# Telegram bot (get the token from @BotFather and keep it only in local .env).
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://127.0.0.1:8000
# Docker Compose overrides API_BASE_URL with http://api:8000 for the bot container.

# Initial IANA timezone for users created through this bot instance.
DEFAULT_TIMEZONE=Europe/Moscow
